# Local operation
local_state/*
!local_state/README.md
frutlups.local.toml
project.local.toml

# Python, tests, builds, and dependencies
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/
*.egg-info/
.venv/
.venv*/
venv/
env/
node_modules/

# Rust build output at any workspace depth. Keep Cargo.lock, Cargo.toml,
# rust-toolchain.toml and .cargo/config.toml tracked for reproducible builds.
target/
*.rs.bk
*.profraw
*.profdata

# Local SQLite stores and their transaction sidecars. Sanitized database
# fixtures, if required, need an explicit narrow exception reviewed with the test.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Secrets and machine-local material
.env
.env.*
# Only sanitized templates belong in Git; never put real values in these files.
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.secret
*.token
credentials*
secrets*
*credentials*.json
service-account*.json

# Logs, temp, editor, and OS noise
*.log
tmp/
temp/
.cache/
.tox/
.nox/
*.orig
*.rej
*.bak
.ipynb_checkpoints/
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.claude/settings.local.json
*.swp
*.swo

# Enable these only when roadmap.yaml declares the llloom memory lane.
# memory/llloom/state/search/
# memory/llloom/state/graph/
# memory/llloom/state/locks/

# Local code-intelligence index; indexing must not dirty a slice baseline.
/.symforge/
